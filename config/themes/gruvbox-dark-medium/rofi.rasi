/* Gruvbox Dark Medium — colores de rofi. Mismos nombres que el template de matugen,
 * mismos valores que ya usan bar.css y hyprland.lua de este tema. */
* {
    background:      #282828D9;
    background-alt:  #d4be9812;
    foreground:      #d4be98;
    foreground-alt:  #a89984;
    accent:          #83a598;
    accent-alt:      #d3869b;
    accent-soft:     #83a59840;
    scrollbar-gradient: linear-gradient(to bottom, #83a59830, #d3869b30);
    border-gradient-h: linear-gradient(to right, #83a598, #d3869b);
    urgent:          #ea6962;
    urgent-fg:       #282828;
    border:          #504945;
}
