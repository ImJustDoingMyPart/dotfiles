// Waybar 0.15.0 — barra del escritorio niri.
//
// Base: nickjj/dotfriedrice (.config/waybar/config.jsonc), adaptada a esta máquina.
// Toda clave escrita acá está verificada contra los man pages que instala el propio
// paquete waybar 0.15.0-2.1 (`man 5 waybar-<modulo>`) — que son la doc oficial de
// exactamente esta versión, no de la última publicada.
//
// Diferencias contra dotfriedrice y por qué:
//   - Sin `battery`: esto es un desktop.
//   - Sin `mpd`: no hay mpd. Se usa `mpris`, que lee cualquier reproductor MPRIS.
//   - Se suman `memory`, `temperature` (CPU) y `custom/gpu`: la máquina es un desktop
//     con RX 6700 XT y eso es lo que interesa mirar.
//   - `niri/workspaces` va SIN on-click/on-click-right/on-click-middle: esas claves no
//     están documentadas para este módulo en 0.15.0 (`man 5 waybar-niri-workspaces` solo
//     lista all-outputs, format, format-icons, disable-click, disable-markup,
//     current-only, on-update, expand). El click izquierdo ya cambia de workspace por
//     defecto (disable-click = false). Overview y niri actions se abren desde
//     `custom/menu`, donde on-click* SÍ está documentado.
//   - El calendario no lleva colores hardcodeados: solo <b>/<u>, para que herede el
//     color del tema y el archivo siga siendo agnóstico de color.
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 24,

  "modules-left": [
    "custom/menu",
    "niri/workspaces"
  ],
  // El centro es `fecha · hora · clima`, con el ':' del reloj clavado en el centro
  // ABSOLUTO de la pantalla (x=960). Los cuatro módulos y su orden no son negociables:
  // `custom/center-pad` es un relleno invisible sin el cual el centrado no se cumple.
  // La aritmética completa está en el docstring de `weather-forecast`; el resumen es que
  // el relleno mide lo que el clima le saca de ancho a la fecha.
  "modules-center": [
    "custom/center-pad",
    "clock#date",
    "clock#time",
    "custom/weather"
  ],
  // Orden pedido por Roberto (2026-08-05), de izquierda a derecha:
  //   bandeja · volumen% · RAM% · GPU% · CPU% · notificaciones
  //
  // `mpris` queda antes de la bandeja pero es INVISIBLE salvo que haya algo sonando
  // (format-stopped = ""), así que no ocupa lugar en reposo.
  //
  // SE QUITARON: `bluetooth`, `network` y `temperature`. Los dos primeros porque casi no
  // se usan y ensuciaban; el tercero porque el porcentaje de CPU ya dice lo que interesa.
  // Nada se pierde: bluetooth y red siguen a un Mod+Comma de distancia en el providerlist
  // (`menus:network` y el provider `bluetooth`), y la temperatura sigue en el tooltip de
  // la CPU y en btop.
  "modules-right": [
    "mpris",
    "group/tray-expander",
    "pulseaudio",
    "memory",
    "custom/gpu",
    "cpu",
    "custom/notification",
    "custom/session"
  ],

  // Menú de sesión en el extremo derecho: bloquear, suspender, cerrar sesión, reiniciar
  // y apagar. Abre el MISMO menú que Mod+X (`menus:session`), que por eso dejó de
  // listarse en el providerlist de Mod+Comma — con la barra y la tecla ya hay dos puertas.
  //
  // El glifo es U+F0425 (nf-md-power), VERIFICADO contra el charset de la fuente antes de
  // escribirlo:  fc-list --format='%{charset}\n' "JetBrainsMono Nerd Font"
  "custom/session": {
    "format": "󰐥",
    "tooltip-format": "Sesión",
    "on-click": "walker --provider menus:session"
  },

  // mako no tiene un modo de streaming como el `swaync-client -swb` que se usaba antes,
  // así que el estado lo arma waybar-mako y se consulta por intervalo.
  "custom/notification": {
    "exec": "waybar-mako",
    "return-type": "json",
    "format": "{}",
    "interval": 3,
    "tooltip": true,
    // Izquierdo abre el historial en walker; derecho alterna No molestar.
    "on-click": "walker --provider menus:notifications",
    "on-click-right": "makoctl mode -t do-not-disturb"
  },

  "custom/menu": {
    "format": "󰣇",
    // Mismo índice que Mod+Comma: el menú `system`, no el provider `providerlist`. Ver el
    // comentario en cfg/keybinds.kdl — es lo que permite volver atrás desde cada submenú.
    "on-click": "walker --provider menus:system",
    "on-click-right": "walker --height 980 --width 980 --provider menus:keybinds",
    "on-click-middle": "walker --height 980 --width 800 --provider menus:waybar",
    "on-click-forward": "walker --provider menus:themes",
    "on-click-backward": "niri msg action toggle-overview",
    "tooltip-format": "Menú del sistema"
  },

  // `{index}` y no `{icon}`: con format-icons, los workspaces sin entrada propia
  // renderizaban CADENA VACÍA y quedaban invisibles. El número siempre se ve, y el
  // estado (activo / urgente) lo marca el CSS, que es donde corresponde.
  "niri/workspaces": {
    "format": "{index}"
  },

  // Relleno INVISIBLE, y el único módulo de la barra que no muestra nada.
  //
  // Waybar centra el BLOQUE `modules-center` como un todo, no un módulo en particular. Con
  // `fecha · hora · clima`, el reloj cae donde caiga: como el clima es más ancho que la
  // fecha, el bloque se corre y el ':' deja de estar en el centro de la pantalla.
  //
  // Este módulo emite exactamente los píxeles que el clima le saca de ancho a la fecha,
  // en espacios duros U+00A0 más —si hace falta— un `<span size=...>` que aporta los 2 px
  // sueltos que no caen en la grilla de 8. Con eso el bloque vuelve a ser simétrico
  // alrededor del reloj y el ':' queda clavado en x=960, midan lo que midan los vecinos: el
  // sobrante se lo come este relleno, en el extremo izquierdo, sobre el fondo de la barra
  // donde no se ve.
  //
  // La deducción completa está en el docstring de `weather-forecast` (modo `--pad`), que es
  // también donde vive la constante 10 (el ancho de `clock#date`). Si se cambia el formato
  // de la fecha o el del reloj, hay que tocar ESE archivo, no éste.
  //
  // Igual que en `custom/weather`: NO poner `escape: true`, o el markup se vería literal.
  //
  // Sin margen: es una regla propia en style.css. Un margen acá desbalancearía la cuenta.
  "custom/center-pad": {
    "exec": "weather-forecast --pad",
    "interval": 900,
    "hide-empty-text": true,
    "tooltip": false
  },

  // La fecha. Se separó del reloj el 2026-08-07 para poder poner la hora en el medio.
  // Conserva TODO lo que tenía el módulo unificado: el grid del mes en el tooltip, el
  // calendario de walker en el click derecho, y el scroll para cambiar de mes.
  //
  // `%a %d %b` mide SIEMPRE 10 caracteres (3+1+2+1+3) en la locale clásica. Ese 10 es la
  // constante `CELDAS_FECHA` de `weather-forecast`: cambiar este formato sin cambiar
  // aquella descentra el reloj.
  //
  // NO se pone `locale`: se probó con es_AR, es_AR.utf8 y es_AR.UTF-8 y NINGUNA cambia el
  // idioma del `format`. El man page es claro en retrospectiva — esa opción está "intended
  // to render times in custom timezones", o sea que aplica a los husos alternativos, no al
  // formato principal. waybar lo renderiza con la locale clásica aunque el proceso tenga
  // LC_TIME=es_AR.UTF-8 (verificado en /proc/PID/environ). Los días y meses quedan en
  // inglés abreviado.
  "clock#date": {
    "format": "{:%a %d %b}",
    // Basta con el minuto: lo único que cambia acá es a medianoche.
    "interval": 60,
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    // Click derecho: calendario en walker, misma superficie que volumen y red.
    // El tooltip del hover sigue mostrando el grid de waybar; el menú suma la navegación
    // por meses y sale en español, que el módulo clock no puede.
    "on-click-right": "walker --provider menus:calendar",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "iso8601": true,
      "format": {
        "months": "<b>{}</b>",
        "weeks": "<small>W{}</small>",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-click-middle": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // La hora, y los dos puntos separadores que la flanquean.
  //
  // Los `·` van ACÁ y no en los módulos vecinos por una razón geométrica: `·  {:%H:%M}  ·`
  // son 11 celdas y el ':' es la celda 5 de 0..10, o sea el MEDIO EXACTO del módulo. Eso es
  // lo que hace que "centrar el reloj" y "centrar el ':'" sean la misma cosa, y lo que
  // cancela el ancho del reloj en la cuenta del relleno. Si se le suma o saca un carácter a
  // un solo lado, el ':' deja de estar en el medio y se descentra todo.
  //
  // SIN `format-alt` (se sacó el 2026-08-07). Alternaba a `%H:%M:%S` con el año, y ese
  // formato mide distinto: al togglear, el ':' se corría. Los segundos no se miran en una
  // barra y el año está en el grid del tooltip de la fecha.
  "clock#time": {
    "format": "·  {:%H:%M}  ·",
    "interval": 1,
    "tooltip": false
  },

  // Clima, a la derecha del reloj. Waybar 0.15.0 NO tiene módulo de clima (los 48
  // `man 5 waybar-*` que instala el paquete no incluyen ninguno), así que es un `custom`
  // con script propio.
  //
  // `weather-forecast` pega contra Open-Meteo, que no pide API key. El mismo script
  // alimenta el menú `menus:weather` (`--menu`) y el relleno de arriba (`--pad`).
  //
  // El `format` es `{}` pelado: los puntos separadores viven en `clock#time` (ver ahí por
  // qué). Cualquier prefijo acá desbalancearía la cuenta del centrado.
  //
  // NO PONER `escape: true`. El texto que devuelve el script trae un `<span size=...>` de
  // Pango: es el espacio de 10 px que separa el glifo de la descripción, sin el cual el
  // glifo se lee pegado al texto (el porqué está en `weather-forecast`). Con `escape` en
  // true se vería el markup literal en la barra. El default ya es false; se deja anotado
  // para que nadie lo "arregle".
  //
  // `interval` 900 contra un cache de 6 HORAS en el script: estas corridas NO salen a la
  // red, solo releen el cache y eligen el bloque horario que corresponde a este momento.
  // O sea: la red se toca 4 veces por día —lo que pidió Roberto— y aun así el número en
  // pantalla se actualiza cada hora. Los 15 minutos son para que al volver de suspensión
  // o de un corte el widget se reacomode rápido.
  "custom/weather": {
    "exec": "weather-forecast --waybar",
    "return-type": "json",
    "format": "{}",
    "hide-empty-text": true,
    "interval": 900,
    "tooltip": true,
    // Derecho: el pronóstico de la semana en walker, misma superficie que la agenda en el
    // click derecho de la fecha. El tooltip del hover cubre el detalle de hoy.
    "on-click-right": "walker --provider menus:weather"
  },

  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-stopped": "",
    "status-icons": {
      "playing": "▶",
      "paused": "⏸"
    },
    "artist-len": 0,
    "album-len": 0,
    "title-len": 40,
    // Sin on-click*: los defaults del módulo ya son play-pause / anterior / siguiente
    // (izq / medio / der). `on-scroll-*` no está documentado para mpris en 0.15.0.
    "tooltip-format": "{title}\n{artist} — {album}"
  },

  // La bandeja va dentro de un drawer: normalmente se ve solo la flechita y se
  // despliega al pasar el mouse. Acá vive el ícono de OpenRGB, que hasta ahora
  // dependía de la bandeja de Noctalia.
  "group/tray-expander": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },

  "custom/expand-icon": {
    "format": "󰅁",
    "tooltip": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": "{icon} 󰂯",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    // Izquierdo abre el MISMO tipo de superficie que bluetooth: un provider de walker.
    // Antes abría wiremix en una terminal, que al lado del launcher GTK del bluetooth se
    // veía como dos sistemas distintos.
    // wiremix sigue accesible en el click del medio, para lo que el provider no cubre:
    // ruteo por aplicación (Spotify a parlantes y Discord a auriculares a la vez).
    "on-click": "walker --provider wireplumber",
    "on-click-middle": "kitty --class wiremix wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  // Waybar no trae módulo de GPU; el script lee sysfs de amdgpu por ruta PCI estable.
  "custom/gpu": {
    "exec": "waybar-gpu",
    "return-type": "json",
    "format": "󰢮 {}",
    "interval": 5,
    "on-click": "kitty --class btop btop"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "states": {
      "warning": 80,
      "critical": 92
    },
    "on-click": "kitty --class btop btop"
  },

  "cpu": {
    "interval": 5,
    "format": "󰘚 {usage}%",
    // El módulo `temperature` se quitó de la barra; la temperatura del CPU sigue visible
    // acá al pasar el mouse, y con detalle en btop (click).
    "tooltip-format": "CPU: {usage}%\nLoad: {load}",
    "states": {
      "warning": 80,
      "critical": 95
    },
    "on-click": "kitty --class btop btop"
  }

}
