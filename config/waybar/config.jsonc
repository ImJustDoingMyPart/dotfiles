// Waybar 0.15.0 — barra del escritorio (Hyprland).
//
// Base: nickjj/dotfriedrice (.config/waybar/config.jsonc), adaptada a esta máquina.
// Toda clave escrita acá está verificada contra los man pages que instala el propio
// paquete waybar 0.15.0-2.1 (`man 5 waybar-<modulo>`) — que son la doc oficial de
// exactamente esta versión, no de la última publicada.
//
// Diferencias contra dotfriedrice y por qué:
//   - Sin `battery`: esto es un desktop.
//   - Sin `mpd`: no hay mpd. Se usa `mpris`, que lee cualquier reproductor MPRIS.
//   - Se suma `custom/system` (CPU, RAM y GPU en un ícono): la máquina es un desktop
//     con RX 6700 XT y eso es lo que interesa mirar.
//   - `hyprland/workspaces` MUESTRA bien pero en 0.15.0 el click no cambia de workspace
//     con Hyprland >= 0.55 (issues #5008 y #5198; los arreglos entraron después de la
//     release). Hasta Waybar 0.16 se cambia de workspace con el teclado.
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 28,

  // `mpris`/`custom/mpris` se mudó acá el 2026-08-25 (a pedido de Roberto), a la derecha
  // de los workspaces. Sigue INVISIBLE cuando no hay nada sonando (texto vacío, ver
  // waybar-mpris) así que no ocupa lugar en reposo. VENTANA (ventana de scroll del título)
  // se acotó a 18 caracteres el 2026-09-10 — ver el docstring largo junto a
  // `modules-center` sobre por qué un ancho variable acá corre el reloj, y por qué NO se
  // puede arreglar espejando el ancho del lado derecho.
  "modules-left": [
    "hyprland/workspaces"
  ],
  // Centrado por SIMETRÍA DE ESPEJOS, igual que en Ironbar (ver el docstring de
  // `weather-forecast`, sección "EL MODO --pad"): `custom/weather-pad` y `clock#date-pad`
  // repiten el MISMO texto que `custom/weather` y `clock#date` con `color: transparent`
  // en style.css. Miden igual por construcción (mismo script/mismo format), así que el
  // ':' de `clock#time` cae en el centro sin ninguna cuenta que mantener.
  //
  // OJO, esto solo garantiza que el ':' esté en el centro DEL BLOQUE modules-center. Ese
  // bloque a su vez lo centra Waybar según cuánto pesan modules-left y modules-right —
  // NO según el centro absoluto de la pantalla. Medido el 2026-09-10 (capturas + CSS de
  // depuración con fondos de color para ubicar los bordes de cada caja en píxeles): el
  // corrimiento del bloque es la mitad de la diferencia (ancho izquierda − ancho derecha).
  //
  // Se probó "espejar" `custom/mpris` con un módulo invisible del mismo ancho en
  // modules-right (`custom/mpris-pad`) para cancelar esa diferencia — funciona en teoría,
  // pero en la práctica cuando el título scrollea a los 42 caracteres originales, sumar
  // ese ancho DOS VECES (una vez real, una vez espejada) hace que el total de las tres
  // cajas supere el ancho de la pantalla, y GTK responde escondiendo por completo
  // los módulos de la derecha (dejaron de aparecer del todo, no solo de
  // achicarse) — peor que el problema original. Se revirtió el mismo día.
  //
  // La solución que quedó es la más simple que de verdad no tiene efectos secundarios:
  // acotar VENTANA en waybar-mpris a 18 caracteres (antes 42), para que el salto de ancho
  // al arrancar/parar música sea chico en vez de grande. El reloj sigue sin estar 100%
  // clavado en el píxel absoluto de la pantalla —eso exigiría que TODO módulo variable de
  // ambos lados sumara siempre lo mismo en las dos cajas, y no hay margen para duplicar tanto
  // contenido sin que algo se recorte—, pero el corrimiento que queda es de un puñado de
  // píxeles, no de cientos.
  "modules-center": [
    "group/center-pill"
  ],
  // De izquierda a derecha: bandeja · volumen% · sistema · notificaciones
  //
  // `custom/system` es UN ícono para CPU, RAM y GPU, con los tres valores en el tooltip.
  // Los tres porcentajes sueltos casi siempre marcaban números chicos y sus glifos se
  // confundían entre sí (el de RAM parecía un procesador, el de GPU una batería).
  //
  // SE QUITARON: `bluetooth`, `network` y `temperature`. Los dos primeros porque casi no
  // se usan y ensuciaban; la temperatura de CPU está en el tooltip de `custom/system`.
  // Nada se pierde: bluetooth y red siguen a un Mod+Comma de distancia en el providerlist
  // (`menus:network` y el provider `bluetooth`).
  //
  // Es `custom` y no los módulos nativos porque `cpu` IGNORA `tooltip-format` (verificado
  // contra el binario 0.15.0: arma su propio tooltip "Total/CoreN") y ni `cpu` ni `memory`
  // tienen campo de temperatura.
  "modules-right": [
    "group/tray-expander",
    "custom/notification"
  ],

  // SACADO (2026-09-03): el botón de sesión que había acá abría el menú de power, pero
  // desde que volvió swaync su control center trae `menu#session` con las mismas cinco
  // acciones (~/.config/swaync/config.json) — una tercera puerta a lo mismo era ruido. El
  // menú de power (rofi-power-menu) sigue vivo por Mod+X.

  // `-swb` es el modo streaming nativo de swaync, documentado en
  // `/usr/share/doc/swaync/README.md`: el módulo se actualiza solo, sin consultar por
  // intervalo. Formato e íconos son el ejemplo oficial de esa doc, verbatim.
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰨝",
      "none": "󰨝",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    // Izquierdo abre el panel de swaync; derecho alterna No molestar.
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/menu": {
    "format": "󰣇",
    // Mismo índice que Mod+Comma (~/.config/rofi/scripts/system-index). Saltar directo a
    // una hoja es ROFI_INFO=leaf:<nombre> antes de invocar rofi: el script lee esa env var
    // en su llamada inicial igual que la reciría de una fila propia (ver el script, línea
    // `info="${ROFI_INFO:-top}"`). Mismo toggle pgrep/pkill que usan los binds de binds.lua.
    "on-click": "sh -c \"pgrep -x rofi >/dev/null && pkill -x rofi || rofi -show system-index -modes system-index:/home/anon/.config/rofi/scripts/system-index -no-sort -eh 2 -kb-move-char-back Control+b -kb-move-char-forward Control+f -kb-accept-entry 'Control+j,Control+m,Return,KP_Enter,Right' -kb-custom-1 Left\"",
    "on-click-right": "sh -c \"pgrep -x rofi >/dev/null && pkill -x rofi || ROFI_INFO=leaf:keybinds rofi -show system-index -modes system-index:/home/anon/.config/rofi/scripts/system-index -no-sort -eh 2 -kb-move-char-back Control+b -kb-move-char-forward Control+f -kb-accept-entry 'Control+j,Control+m,Return,KP_Enter,Right' -kb-custom-1 Left\"",
    "on-click-middle": "sh -c \"pgrep -x rofi >/dev/null && pkill -x rofi || ROFI_INFO=leaf:waybar rofi -show system-index -modes system-index:/home/anon/.config/rofi/scripts/system-index -no-sort -eh 2 -kb-move-char-back Control+b -kb-move-char-forward Control+f -kb-accept-entry 'Control+j,Control+m,Return,KP_Enter,Right' -kb-custom-1 Left\"",
    "on-click-forward": "sh -c \"pgrep -x rofi >/dev/null && pkill -x rofi || ROFI_INFO=leaf:themes rofi -show system-index -modes system-index:/home/anon/.config/rofi/scripts/system-index -no-sort -eh 2 -kb-move-char-back Control+b -kb-move-char-forward Control+f -kb-accept-entry 'Control+j,Control+m,Return,KP_Enter,Right' -kb-custom-1 Left\"",
    "on-click-backward": "sh -c 'pgrep -x rofi >/dev/null && pkill -x rofi || rofi -show window'",
    "tooltip-format": "Menú del sistema"
  },

  // `{index}` y no `{icon}`: con format-icons, los workspaces sin entrada propia
  // renderizaban CADENA VACÍA y quedaban invisibles. El número siempre se ve, y el
  // estado (activo / urgente) lo marca el CSS, que es donde corresponde.
  // Mínimo 3 workspaces visibles (ocupados o no) vía persistent-workspaces.
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X",
      "default": "{id}"
    },
    "persistent-workspaces": {
      "*": 3
    }
  },

  // Relleno INVISIBLE, y el único módulo de la barra que no muestra nada.
  //
  // Waybar centra el BLOQUE `modules-center` como un todo, no un módulo en particular. Con
  // `fecha · hora · clima`, el reloj cae donde caiga: como el clima es más ancho que la
  // fecha, el bloque se corre y el ':' deja de estar en el centro de la pantalla.
  //
  // Este módulo emite exactamente los píxeles que el clima le saca de ancho a la fecha,
  // en espacios duros U+00A0 más —si hace falta— un `<span size=...>` que aporta los 2 px
  // sueltos que no caen en la grilla de 8. Con eso el bloque vuelve a ser simétrico
  // alrededor del reloj y el ':' queda clavado en x=960, midan lo que midan los vecinos: el
  // sobrante se lo come este relleno, en el extremo izquierdo, sobre el fondo de la barra
  // donde no se ve.
  //
  // La deducción completa está en el docstring de `weather-forecast` (modo `--pad`), que es
  // también donde vive la constante 10 (el ancho de `clock#date`). Si se cambia el formato
  // de la fecha o el del reloj, hay que tocar ESE archivo, no éste.
  //
  // Igual que en `custom/weather`: NO poner `escape: true`, o el markup se vería literal.
  //
  // MISMO margen que `custom/weather` (style.css lo incluye en la lista compartida de
  // 8px): la simetría exige que el espejo pese lo mismo que el original, margen incluido.
  // Lo invisible lo hace `color: transparent` en style.css, no este módulo.
  "custom/weather-pad": {
    "exec": "weather-forecast --pad",
    "interval": 900,
    // El scroll/click de `custom/weather` no llega acá (recibe el evento el widget bajo
    // el mouse, y éste es invisible). `weather-forecast --nav` manda SIGRTMIN+1 al
    // escribir el índice para que el espejo se reacomode EN EL MISMO instante — si
    // esperara al próximo `interval`, el ':' del reloj se correría mientras tanto. Ver
    // el docstring de `weather-forecast`.
    "signal": 1,
    "hide-empty-text": true,
    "tooltip": false
  },

  // La fecha. Se separó del reloj el 2026-08-07 para poder poner la hora en el medio.
  //
  // Pasó de `clock#date` a `custom/date` el 2026-08-25: el módulo `clock` nativo de
  // Waybar SIEMPRE renderiza en locale clásica (inglés) pase lo que pase con la locale
  // del proceso — verificado entonces contra `man 5 waybar-clock` y `/proc/PID/environ`,
  // no hay forma de sacarle español. `custom/date` en cambio corre `date(1)` de verdad,
  // que sí hereda la locale del shell (`es_AR.utf8` acá, sin que haga falta forzar
  // `LC_TIME`) y da "mar 25 ago" en vez de "Tue 25 Aug".
  //
  // Se pierde el grid del mes en el tooltip nativo y el scroll-para-cambiar-de-mes de
  // `clock` (un `custom` no tiene esas actions) — se acepta la pérdida a cambio de tener
  // fecha en español, porque el calendario de verdad (con eventos de Google Calendar)
  // ya vive en la hoja "Agenda" de system-index, estrictamente más útil que el grid offline.
  //
  // `%a %d %b` en es_AR.utf8 sigue midiendo 10 caracteres (3+1+2+1+3: "mar 25 ago",
  // "dom 15 mar", "mié 12 nov"...) — comprobado con `date -d` sobre los 7 días de la
  // semana. Ese 10 sigue siendo la constante `CELDAS_FECHA` de `weather-forecast`.
  "custom/date": {
    "exec": "waybar-date",
    "return-type": "json",
    "interval": 60,
    "tooltip": false,
    "escape": false,
    // Izquierdo Y derecho abren el mismo popup — paridad con Ironbar (config.json:
    // `clock-date` tiene `on_click_left` y `on_click_right` apuntando los dos acá).
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -t -sw"
  },

  // Espejo invisible de `custom/date`, del lado derecho del reloj — el otro lado de la
  // simetría. MISMO `exec` que `custom/date` (así pesa igual, y no hay drift posible:
  // mismo comando, mismo momento); sin tooltip ni clicks porque no se ve ni se toca.
  "custom/date-pad": {
    "exec": "waybar-date",
    "return-type": "json",
    "interval": 60,
    "tooltip": false
  },

  // La hora, y los dos puntos separadores que la flanquean.
  //
  // Los `·` van ACÁ y no en los módulos vecinos por una razón geométrica: `·  {:%H:%M}  ·`
  // son 11 celdas y el ':' es la celda 5 de 0..10, o sea el MEDIO EXACTO del módulo. Eso es
  // lo que hace que "centrar el reloj" y "centrar el ':'" sean la misma cosa, y lo que
  // cancela el ancho del reloj en la cuenta del relleno. Si se le suma o saca un carácter a
  // un solo lado, el ':' deja de estar en el medio y se descentra todo.
  //
  // SIN `format-alt` (se sacó el 2026-08-07). Alternaba a `%H:%M:%S` con el año, y ese
  // formato mide distinto: al togglear, el ':' se corría. Los segundos no se miran en una
  // barra y el año está en el grid del tooltip de la fecha.
  "clock#time": {
    "format": "{:%H:%M}",
    "interval": 1,
    "tooltip": false
  },

  // Clima, a la derecha del reloj. Waybar 0.15.0 NO tiene módulo de clima (los 48
  // `man 5 waybar-*` que instala el paquete no incluyen ninguno), así que es un `custom`
  // con script propio.
  //
  // `weather-forecast` pega contra Open-Meteo, que no pide API key. El mismo script
  // alimenta el menú `menus:weather` (`--menu`) y el relleno de arriba (`--pad`).
  //
  // El `format` es `{}` pelado: los puntos separadores viven en `clock#time` (ver ahí por
  // qué). Cualquier prefijo acá desbalancearía la cuenta del centrado.
  //
  // NO PONER `escape: true`. El texto que devuelve el script trae un `<span size=...>` de
  // Pango: es el espacio de 10 px que separa el glifo de la descripción, sin el cual el
  // glifo se lee pegado al texto (el porqué está en `weather-forecast`). Con `escape` en
  // true se vería el markup literal en la barra. El default ya es false; se deja anotado
  // para que nadie lo "arregle".
  //
  // `interval` 900 contra un cache de 6 HORAS en el script: estas corridas NO salen a la
  // red, solo releen el cache y eligen el bloque horario que corresponde a este momento.
  // O sea: la red se toca 4 veces por día —lo que pidió Roberto— y aun así el número en
  // pantalla se actualiza cada hora. Los 15 minutos son para que al volver de suspensión
  // o de un corte el widget se reacomode rápido.
  "custom/weather": {
    "exec": "weather-forecast --waybar",
    "return-type": "json",
    "format": "{}",
    "hide-empty-text": true,
    "interval": 900,
    "tooltip": true,
    // Scroll cicla los 7 días del pronóstico, click izquierdo repone hoy. El derecho abre
    // la semana completa en la hoja "Clima" de system-index.
    "on-click": "weather-forecast --notify",
    "on-click-right": "swaync-client -t -sw",
    "on-scroll-up": "weather-forecast --nav +1",
    "on-scroll-down": "weather-forecast --nav -1"
  },

  // `mpris` nativo → `custom/mpris` el 2026-08-25 (a pedido de Roberto). Primero se le
  // sacó `position`/`length` de `dynamic-order` porque Waybar envuelve ese segmento en
  // `<small>` de forma INCONDICIONAL (src/modules/mpris/mpris.cpp — sin clave de config
  // para sacarlo) y encima no se actualizaba solo (con `interval: 0`, el default, el
  // módulo solo se repinta ante eventos D-Bus, que la posición casi nunca dispara).
  // Después pidió que el título recorra completo con scroll en vez de truncarse con "…".
  // Waybar no tiene marquee para NINGÚN módulo (`rotate` gira la etiqueta entera, no la
  // desplaza — no existe la palabra "marquee" en ningún man page de 0.15.0), y la única
  // forma de recorrer texto es armar la ventana deslizante a mano, lo que exige control
  // total del texto en cada tick — algo que un `format` estático no puede dar.
  //
  // `waybar-mpris` arma el título+artista y lo desliza en una ventana de 42 caracteres,
  // 2 por tick (`interval: 1` → 2 caracteres/segundo). Se probó también un `<span
  // size='…'>` para achicar el texto respecto del resto de la barra, y se revirtió (letra
  // al 100%, igual que todo lo demás): quedaba mal a cualquier tamaño reducido.
  "custom/mpris": {
    "exec": "waybar-mpris",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "on-click": "playerctl --player=playerctld play-pause",
    "on-click-middle": "playerctl --player=playerctld previous",
    "on-click-right": "playerctl --player=playerctld next"
  },

  // La bandeja va dentro de un drawer: normalmente se ve solo la flechita y se
  // despliega al pasar el mouse. Acá vive el ícono de OpenRGB, que hasta ahora
  // dependía de la bandeja de Noctalia.
  "group/tray-expander": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },

  "custom/expand-icon": {
    "format": "󰅁",
    "tooltip": false
  },

  // spacing entre íconos DENTRO del tray (gap interno de íconos individuales, no el
  // margen del módulo contra sus vecinos, que sigue siendo el 8px por lado de style.css).
  // Subido de 10 a 17 imitando el gap interno de Omarchy 3.8.4 (2026-08-25, a pedido de
  // Roberto, quien probó y aprobó dejar el 16px uniforme de módulos intacto y tocar solo
  // esto).
  "tray": {
    "icon-size": 14,
    "spacing": 10,

    // Los íconos salen del paquete apuntado por ~/.local/share/waybar-tray/icons/pack
    // (ver el drop-in tray-icons.conf de waybar.service). Acá van SOLO los ítems que
    // no consultan el tema por su cuenta: vesktop y openrgb publican un pixmap crudo,
    // y Steam impone su propio IconThemePath con un PNG de su directorio. Darles un
    // nombre los mete en la resolución normal del tema.
    //
    // Cachy-Update NO va acá a propósito: publica IconName y cambia de ícono al
    // detectar updates (escribe el nombre en ~/.local/state/arch-update/tray_icon y
    // el tray lo relee por inotify). Un override de este mapa se pierde en ese
    // cambio, porque Waybar solo lo aplica cuando llega la propiedad `Id` y el
    // NewIcon repone IconName sin volver a pasar por ahí. Sus dos nombres se pisan
    // desde el tema `Bandeja`, que sí sobrevive al cambio de estado.
    "icons": {
      "steam": "steam",
      "openrgb": "openrgb",
      "vesktop_status_icon_1": "vesktop"
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": "{icon} 󰂯",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    // SIN on-click (2026-09-03): izquierdo abría el selector de salida por defecto. Desde
    // que volvió swaync, su control center cubre lo mismo con el widget `volume` y
    // `menu#audio` (~/.config/swaync/config.json) — abrir el panel de swaync ya está a un
    // click del widget de notificaciones. El selector por aplicación sigue disponible como
    // hoja "Audio por aplicación" en Multimedia dentro de system-index (Mod+Comma). Este
    // widget de volumen no lleva a nada en su click izquierdo.
    // wiremix sigue accesible en el click del medio, para lo que ningún menú cubre:
    // ruteo por aplicación (Spotify a parlantes y Discord a auriculares a la vez).
    "on-click-middle": "kitty --class wiremix wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  // CPU, RAM y GPU juntos (ver `~/.local/bin/waybar-sys`): el texto es solo el glifo, el
  // tooltip trae los tres valores y la clase warning/critical es la peor de las tres.
  // `waybar-cpu`/`-mem`/`-gpu` siguen siendo la fuente de cada valor y de cada umbral.
  "custom/system": {
    "exec": "waybar-sys",
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "on-click": "kitty --class btop btop"
  }

,

  "group/center-pill": {
    "orientation": "horizontal",
    "modules": [
      "custom/date",
      "custom/separator",
      "clock#time"
    ]
  },

  "custom/separator": {
    "format": "›",
    "tooltip": false
  },

  // Píldora de ajustes rápidos / Centro de control (abre swaync)
  "group/quicksettings": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio#quicksettings",
      "network#quicksettings",
      "custom/tools",
      "custom/notification",
      "custom/session"
    ]
  },

  "pulseaudio#quicksettings": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-bluetooth": "{icon}",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },

  "network#quicksettings": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },

  "custom/tools": {
    "format": "",
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },

  "custom/session": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  }
,

  "custom/separator#1": {
    "format": "│",
    "tooltip": false
  },

  "custom/separator#2": {
    "format": "•",
    "tooltip": false
  }
}
