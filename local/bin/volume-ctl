#!/usr/bin/env bash
# Envoltorio de volumen para los atajos de teclado (XF86Audio*). Con el panel de swaync
# CERRADO se comporta exactamente como antes: swayosd-client cambia el volumen y dibuja
# el OSD en un solo paso. Con el panel ABIERTO, el propio slider de swaync ya muestra el
# nivel — mostrar TAMBIÉN el OSD flotante es redundante, así que acá se cambia el volumen
# directo por wpctl, sin OSD.
#
# Uso: volume-ctl {raise|lower|mute-toggle|mic-mute-toggle}

action="${1:?uso: volume-ctl raise/lower/mute-toggle/mic-mute-toggle}"

if swaync-panel-open; then
    case "$action" in
        raise) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
        lower) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
        mute-toggle) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        mic-mute-toggle) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
        *) echo "volume-ctl: acción desconocida: $action" >&2; exit 1 ;;
    esac
else
    case "$action" in
        raise) swayosd-client --output-volume raise --max-volume 100 ;;
        lower) swayosd-client --output-volume lower ;;
        mute-toggle) swayosd-client --output-volume mute-toggle ;;
        mic-mute-toggle) swayosd-client --input-volume mute-toggle ;;
        *) echo "volume-ctl: acción desconocida: $action" >&2; exit 1 ;;
    esac
fi
