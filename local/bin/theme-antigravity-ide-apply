#!/usr/bin/env bash
# Inyecta workbench.colorCustomizations en ~/.config/Antigravity IDE/User/settings.json
# desde el tema activo. Se llama como post_hook de matugen y desde theme-reload.

set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
activo=$(cat "$THEMES_DIR/.activo" 2>/dev/null || echo "")
src="$THEMES_DIR/$activo/antigravity-ide.json"

[[ -n $activo && -r $src ]] || exit 0
command -v jq >/dev/null || exit 0

for config_dir in "$HOME/.config/Antigravity IDE/User" "$HOME/.config/Antigravity/User"; do
  [[ -d $config_dir ]] || continue
  settings_file="$config_dir/settings.json"

  if [[ ! -f $settings_file ]]; then
    cp "$src" "$settings_file"
    continue
  fi

  tmp=$(mktemp "$settings_file.tmp.XXXXXX")
  jq -s '
    .[0]["workbench.colorCustomizations"] = .[1]["workbench.colorCustomizations"]
    | .[0]
  ' "$settings_file" "$src" > "$tmp"

  cmp -s "$settings_file" "$tmp" || cat "$tmp" > "$settings_file"
  rm -f "$tmp"
done
