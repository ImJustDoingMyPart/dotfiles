#!/usr/bin/env bash
# Switcher de tema de cursor.
#
# Uso:
#   cursor-set                  lista los temas de cursor disponibles y marca el activo
#   cursor-set --actual         imprime "<tema> <tamaño>"
#   cursor-set <tema> [tamaño]  lo aplica (tamaño por defecto: el que ya estaba)
#
# El cursor no tiene una sola fuente de verdad, así que se escribe en cuatro lugares:
#
#   1. ~/.config/uwsm/env (XCURSOR_THEME, XCURSOR_SIZE, HYPRCURSOR_SIZE): el entorno de la
#      sesión. Lo heredan Hyprland, los servicios de systemd de la sesión y todo lo que se
#      lance. Es la fuente del estado (--actual) y se aplica completo en el próximo login.
#   2. `hyprctl setcursor <tema> <tamaño>`: el cursor del compositor, en caliente. Acepta
#      temas XCursor además de hyprcursor (probado con Adwaita, que es XCursor).
#   3. gsettings cursor-theme/cursor-size: lo que leen las apps GTK nativas en caliente
#      (verificado con Gtk.Settings.get_default(), no de memoria).
#   4. gtk-3.0/gtk-4.0 settings.ini, por la misma razón que font-set también lo toca ahí:
#      una app en Flatpak puede tener ~/.config bind-mounteado sin acceso a dconf/gsettings
#      del host, y ahí settings.ini es la única fuente que le llega.
#
# Sin motor de color acá: ningún tema de cursor instalado trae variantes de hue, así que esto
# es un selector plano, sin acoplamiento a matugen.

set -euo pipefail

UWSM_ENV="$HOME/.config/uwsm/env"
GTK3_INI="$HOME/.config/gtk-3.0/settings.ini"
GTK4_INI="$HOME/.config/gtk-4.0/settings.ini"
GS_IFACE="org.gnome.desktop.interface"

list_cursor_themes() {
  local base d name
  for base in /usr/share/icons "$HOME/.icons" "$HOME/.local/share/icons"; do
    [[ -d $base ]] || continue
    for d in "$base"/*/; do
      d=${d%/}
      name=$(basename "$d")
      [[ -d "$d/cursors" ]] || continue
      find "$d/cursors" -mindepth 1 -maxdepth 1 \( -type f -o -type l \) -print -quit 2>/dev/null |
        grep -q . && echo "$name"
    done
  done | sort -u
}

actual_theme() { sed -n 's/^export XCURSOR_THEME="\(.*\)"$/\1/p' "$UWSM_ENV" | head -1; }
actual_size()  { sed -n 's/^export XCURSOR_SIZE="\([0-9]\+\)"$/\1/p' "$UWSM_ENV" | head -1; }

# Igual que gtk_ini() en font-set: reescribe con awk sobre un temporal y hace `cat` (no
# `mv`) para conservar permisos y dueño. Si la clave no está, avisa y deja el archivo
# como estaba en vez de agregarla a ciegas.
sync_cursor_ini() {
  local file="$1" theme="$2" size="$3" tmp
  [[ -f $file ]] || return 0
  tmp=$(mktemp)
  if awk -v theme="$theme" -v size="$size" '
      /^gtk-cursor-theme-name=/ { $0 = "gtk-cursor-theme-name=" theme; hecho_n = 1 }
      /^gtk-cursor-theme-size=/ { $0 = "gtk-cursor-theme-size=" size; hecho_s = 1 }
      { print }
      END { if (!hecho_n || !hecho_s) exit 3 }
    ' "$file" >"$tmp"; then
    cat "$tmp" >"$file"
  else
    echo "cursor-set: aviso — no encontré gtk-cursor-theme-name/size en $file, lo dejo como estaba" >&2
  fi
  rm -f "$tmp"
}

# Mismo criterio para el env de uwsm: se reemplazan las tres líneas existentes. Si falta
# alguna, se avisa en vez de agregarla: ese archivo es config escrita a mano.
sync_uwsm_env() {
  local theme="$1" size="$2" tmp
  tmp=$(mktemp)
  if awk -v theme="$theme" -v size="$size" '
      /^export XCURSOR_THEME=/   { $0 = "export XCURSOR_THEME=\"" theme "\""; t = 1 }
      /^export XCURSOR_SIZE=/    { $0 = "export XCURSOR_SIZE=\"" size "\""; s = 1 }
      /^export HYPRCURSOR_SIZE=/ { $0 = "export HYPRCURSOR_SIZE=\"" size "\""; h = 1 }
      { print }
      END { if (!t || !s || !h) exit 3 }
    ' "$UWSM_ENV" >"$tmp"; then
    cat "$tmp" >"$UWSM_ENV"
  else
    echo "cursor-set: aviso — faltan XCURSOR_THEME/XCURSOR_SIZE/HYPRCURSOR_SIZE en $UWSM_ENV, lo dejo como estaba" >&2
  fi
  rm -f "$tmp"
}

case "${1:-}" in
  --actual) echo "$(actual_theme) $(actual_size)"; exit 0 ;;
  "")
    active=$(actual_theme)
    while read -r t; do
      [[ $t == "$active" ]] && echo "* $t" || echo "  $t"
    done < <(list_cursor_themes)
    exit 0
    ;;
esac

theme="$1"
size="${2:-$(actual_size)}"
size="${size:-24}"

if ! list_cursor_themes | grep -qx "$theme"; then
  echo "cursor-set: no existe el tema de cursor '$theme'" >&2
  exit 1
fi

sync_uwsm_env "$theme" "$size"
hyprctl setcursor "$theme" "$size" >/dev/null 2>&1 || true
gsettings set $GS_IFACE cursor-theme "$theme"
gsettings set $GS_IFACE cursor-size "$size"
sync_cursor_ini "$GTK3_INI" "$theme" "$size"
sync_cursor_ini "$GTK4_INI" "$theme" "$size"

echo "cursor-set: activado '$theme' tamaño $size (completo en el próximo login)"
