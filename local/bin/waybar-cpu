#!/usr/bin/env bash
# Módulo custom de Waybar: uso de CPU + tooltip de temperatura real.
#
# Se reemplazó al módulo nativo `cpu` el 2026-08-25 (a pedido de Roberto) porque, contra lo
# que decía el comentario viejo de config.jsonc, el `tooltip-format` de `cpu` NUNCA se
# aplicaba: verificado contra el binario 0.15.0 (src/modules/cpu_usage/common.cpp) — el
# módulo arma su propio tooltip ("Total: X%\nCoreN: X%...") y no lee esa clave del config en
# absoluto. Tampoco existe un campo `{temperature}` para `cpu`: la temperatura SIEMPRE fue un
# módulo aparte (`temperature`), que se había sacado de la barra. Sin módulo `custom`, no hay
# forma de que el tooltip de CPU muestre su temperatura real.
#
# Uso: se calcula igual que top/htop — dos lecturas de /proc/stat separadas por un delay
# corto, y la diferencia de tiempo "ocupado" sobre tiempo total. Con `interval: 5` en
# config.jsonc este script se re-ejecuta entero cada vez (no hay estado entre invocaciones de
# un módulo `custom`), así que el delay va DENTRO del script, no en un archivo de estado.
#
# Temperatura: Tctl de k10temp, el mismo valor que reporta `sensors` y que usan la mayoría de
# monitores en Ryzen (no Tccd1, que es por chiplet). Resuelto por NOMBRE del hwmon, no por
# número: el número baila entre arranques según el orden de sondeo (mismo criterio que
# waybar-gpu con el PCI BDF).

set -euo pipefail

find_hwmon() {
  local want="$1" n d
  for d in /sys/class/hwmon/hwmon*; do
    n=$(cat "$d/name" 2>/dev/null) || continue
    [[ "$n" == "$want" ]] && { echo "$d"; return 0; }
  done
  return 1
}

read_stat_line() {
  # La primera línea de /proc/stat: cpu  user nice system idle iowait irq softirq steal
  awk '/^cpu / {for (i=2;i<=NF;i++) printf "%s ", $i; print ""}' /proc/stat
}

sample1=$(read_stat_line)
sleep 0.3
sample2=$(read_stat_line)

usage=$(awk -v s1="$sample1" -v s2="$sample2" '
  BEGIN {
    n1 = split(s1, a, " ")
    n2 = split(s2, b, " ")
    idle1 = a[4] + a[5]   # idle + iowait
    idle2 = b[4] + b[5]
    total1 = 0; total2 = 0
    for (i = 1; i <= n1; i++) total1 += a[i]
    for (i = 1; i <= n2; i++) total2 += b[i]
    dt = total2 - total1
    di = idle2 - idle1
    if (dt <= 0) { print 0; exit }
    printf "%.0f", 100 * (dt - di) / dt
  }
')

k10=$(find_hwmon k10temp || true)
temp="?"
if [[ -n "$k10" && -r "$k10/temp1_input" ]]; then
  temp=$(( $(cat "$k10/temp1_input") / 1000 ))
fi

if   (( usage >= 95 )); then class="critical"
elif (( usage >= 80 )); then class="warning"
else                         class=""
fi

printf '{"text":"%s%%","percentage":%s,"class":"%s","tooltip":"CPU %s°C"}\n' \
  "$usage" "$usage" "$class" "$temp"
