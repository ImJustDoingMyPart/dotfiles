#!/usr/bin/env bash
# Fija la CARPETA RAÍZ donde el menú de wallpapers busca colecciones.
#
# Uso:  wallpaper-root-set <carpeta>
#       wallpaper-root-set --actual     imprime la raíz vigente
#       wallpaper-root-set --reset      vuelve al default (borra el estado)
#
# Por qué un archivo de estado y no una variable de entorno: el menú de rofi es un
# proceso nuevo en cada apertura, así que relee el archivo solo y el cambio se ve al
# instante sin reiniciar nada.
#
# Por qué un script aparte y no lógica adentro del menú: así la raíz también se
# cambia desde la terminal y desde cualquier otro script, igual que `wallpaper-set`
# y `theme-set`. El menú es una puerta más, no la única.

set -euo pipefail

STATE_FILE="$HOME/.local/state/wallpaper-root"
DEFAULT_DIR="$HOME/Imágenes"

actual() {
  if [[ -r $STATE_FILE ]]; then
    local dir
    dir=$(<"$STATE_FILE")
    # Una raíz que ya no existe (disco desmontado, carpeta renombrada) no se reporta:
    # el menú tiene que caer al default en vez de mostrar una lista vacía.
    if [[ -d $dir ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  fi
  printf '%s\n' "${WALLPAPERS_DIR:-$DEFAULT_DIR}"
}

case "${1:-}" in
--actual)
  actual
  exit 0
  ;;
--reset)
  rm -f "$STATE_FILE"
  printf 'wallpaper-root-set: %s (default)\n' "$(actual)"
  exit 0
  ;;
esac

dir="${1:-}"

if [[ -z $dir || ! -d $dir ]]; then
  echo "wallpaper-root-set: pasá una carpeta existente" >&2
  exit 1
fi

# Ruta absoluta y sin symlinks: el estado lo lee después otro proceso (el menú de
# rofi), y una relativa apuntaría a cualquier lado.
dir=$(realpath "$dir")

mkdir -p "$(dirname "$STATE_FILE")"
printf '%s\n' "$dir" > "$STATE_FILE"

echo "wallpaper-root-set: $dir"
